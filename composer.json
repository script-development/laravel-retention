{
    "name": "script-development/laravel-retention",
    "description": "Retention kernel for Laravel territories: a prune for append-only, hash-chained audit tables that keeps the remaining chain verifiable.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "audit",
        "retention",
        "hash-chain"
    ],
    "require": {
        "php": "^8.5",
        "illuminate/container": "^13.39",
        "illuminate/contracts": "^13.39",
        "illuminate/database": "^13.39",
        "illuminate/support": "^13.39",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "infection/infection": "^0.34.0",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "ScriptDevelopment\\LaravelRetention\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScriptDevelopment\\LaravelRetention\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ScriptDevelopment\\LaravelRetention\\RetentionServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-clover=build/logs/clover.xml --coverage-text",
        "coverage:check": "@php bin/coverage-check.php build/logs/clover.xml 100",
        "mutation": "infection --threads=max --show-mutations",
        "mutation:ci": "infection --threads=4 --no-progress --logger-github --min-msi=90 --min-covered-msi=90",
        "phpstan": "phpstan analyse",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
